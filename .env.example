# docker compose reads .env (ignored by git). Copy this file to .env and fill in.

# Auth.js session encryption. Generate with: npx auth secret
AUTH_SECRET=

# Optional: the local PostgreSQL password (default authserver_dev).
# POSTGRES_PASSWORD=

# Optional: what GET /api/version reports. PowerShell: $env:COMMIT = git rev-parse HEAD
# VERSION=0.1.0
# COMMIT=

# Optional: host ports (defaults 3100 / 5180 / 5433).
# FRONTEND_PORT=3100
# BACKEND_PORT=5180
# POSTGRES_PORT=5433
