<Project>

  <!-- Central package management: the one place a version lives. No .csproj carries a version.
       Packages listed here but referenced by no project are decided and wired with the first
       module (architecture.md §4.1). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Host and modules">
    <PackageVersion Include="FastEndpoints" Version="8.3.0" />
    <PackageVersion Include="FastEndpoints.Swagger" Version="8.3.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Identity and the authorization server">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.7.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <!-- The Data Protection key ring in the identity schema: refresh tokens, authorization codes
         and cookies survive a restart. -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
  </ItemGroup>

  <!-- TickerQ 11 targets net11.0 only: 10.x until the runtime moves. -->
  <ItemGroup Label="Background work and telemetry">
    <PackageVersion Include="TickerQ" Version="10.5.0" />
    <PackageVersion Include="TickerQ.EntityFrameworkCore" Version="10.5.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <!-- Pre-release: pinned exactly, a range on a pre-release is a decision nobody made. -->
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="[1.20.1-beta.1]" />
  </ItemGroup>

  <ItemGroup Label="Test stack: the xunit / runner / Test.Sdk trio is pinned together">
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnit" Version="0.13.5" />
    <!-- The software WebAuthn authenticator writes CBOR. -->
    <PackageVersion Include="System.Formats.Cbor" Version="10.0.14" />
  </ItemGroup>

</Project>
