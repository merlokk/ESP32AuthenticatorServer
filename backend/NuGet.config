<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Central package management needs one source per package (NU1507); <clear /> keeps a restore
       independent of the machine's user-level feeds. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
