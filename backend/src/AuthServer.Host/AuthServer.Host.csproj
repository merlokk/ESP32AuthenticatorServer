<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Local secrets (Identity:TotpEncryptionKey, the connection string): dotnet user-secrets. -->
    <UserSecretsId>authserver-host</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" />
    <PackageReference Include="FastEndpoints.Swagger" />
    <!-- The one bearer scheme every module's endpoints read (architecture.md §4.5). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Design time only: dotnet ef resolves the contexts through this project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Metrics only: a Prometheus scrape endpoint, no OTLP exporter yet (architecture.md §4.1). -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebApplicationFactory needs the internal Program generated by top-level statements. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>AuthServer.IntegrationTests</_Parameter1>
    </AssemblyAttribute>
    <!-- The host's own unit tests: what they cover is internal and should stay so. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>AuthServer.Host.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- The composition root references every module; a module never references another's
         implementation (architecture.md §3). -->
    <ProjectReference Include="..\AuthServer.Shared\AuthServer.Shared.csproj" />
    <ProjectReference Include="..\Modules\Identity\AuthServer.Identity\AuthServer.Identity.csproj" />
    <ProjectReference Include="..\Modules\Identity\AuthServer.Identity.Contracts\AuthServer.Identity.Contracts.csproj" />
    <ProjectReference Include="..\Modules\Sync\AuthServer.Sync\AuthServer.Sync.csproj" />
    <ProjectReference Include="..\Modules\Firmware\AuthServer.Firmware\AuthServer.Firmware.csproj" />
  </ItemGroup>

</Project>
