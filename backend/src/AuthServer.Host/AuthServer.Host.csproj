<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- Metrics only: a Prometheus scrape endpoint, no OTLP exporter yet (architecture.md §4.1). -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebApplicationFactory needs the internal Program generated by top-level statements. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>AuthServer.IntegrationTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- The composition root references every module; a module never references another's
         implementation (architecture.md §3). -->
    <ProjectReference Include="..\AuthServer.Shared\AuthServer.Shared.csproj" />
  </ItemGroup>

</Project>
